// Static Go Mode website assets and custom-domain routing.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gomode-web",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "gomode.dev",
      "custom_domain": true,
    },
    {
      "pattern": "www.gomode.dev",
      "custom_domain": true,
    },
  ],
}
