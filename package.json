{
  "name": "gomode-dev",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm run verify && wrangler deploy --dry-run --outdir .wrangler/build",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "wrangler dev",
    "fix": "prettier --write . && python3 scripts/update_agents_file_index.py",
    "prepare": "scripts/install-git-hooks.sh",
    "screenshots": "python3 scripts/screenshots.py",
    "verify": "prettier --check . && python3 scripts/update_agents_file_index.py --check && python3 scripts/screenshots.py --check && pnpm run test && pnpm run typecheck",
    "test": "python3 -m unittest discover -s scripts -p \"test_*.py\"",
    "test:browser": "pnpm run build && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "wrangler": "4.143.0",
    "prettier": "3.8.2",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=12.4.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.9.0",
      "onFail": "download"
    }
  }
}
