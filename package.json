{
  "name": "gomodev-dev",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "python3 scripts/update_agents_file_index.py --check && wrangler deploy --define BUILD_VERSION:\"\\\"$(git rev-parse --short HEAD)\\\"\"",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "fix": "python3 scripts/update_agents_file_index.py",
    "verify": "python3 scripts/update_agents_file_index.py --check",
    "prepare": "scripts/install-git-hooks.sh",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build"
  },
  "devDependencies": {
    "wrangler": "4.135.0"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=12.4.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.9.0",
      "onFail": "download"
    }
  }
}
