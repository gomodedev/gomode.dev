{
  "name": "gomode-dev",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm run verify && wrangler deploy --dry-run --outdir .wrangler/build",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "wrangler dev",
    "fix": "prettier --write . && python3 scripts/update_agents_file_index.py",
    "prepare": "scripts/install-git-hooks.sh",
    "screenshots": "python3 scripts/screenshots.py",
    "verify": "prettier --check . && python3 scripts/update_agents_file_index.py --check && python3 scripts/screenshots.py --check && pnpm run typecheck",
    "test:browser": "pnpm run build && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "wrangler": "4.156.0"
  },
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=12.17.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  }
}
